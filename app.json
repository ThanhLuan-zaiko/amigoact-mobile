{
  "expo": {
    "name": "AmigoACT",
    "slug": "amigoact-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "AmigoACT cần quyền truy cập ảnh để bạn đăng ảnh và video.",
          "cameraPermission": "AmigoACT cần camera để chụp ảnh cho bài viết."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AmigoACT cần camera để quét mã QR điểm danh.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "amigoact"
  }
}
