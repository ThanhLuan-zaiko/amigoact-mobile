# Copy this file to .env and fill it in. Never commit .env.

# Address of the backend API, for example the internal address of amigoact-be.
BACKEND_URL=

# Random secret of at least 32 characters. Must equal INTERNAL_API_KEY in the
# backend .env. The gateway adds it to every HTTP request it forwards, so the
# mobile app never holds it. Create one with: openssl rand -hex 32
INTERNAL_API_KEY=

# Optional. Defaults are shown.
# PORT=8200
# Requests per minute per client IP. AUTH_RATE_LIMIT covers login, register and password routes.
# RATE_LIMIT=300
# AUTH_RATE_LIMIT=20
# Largest request body in megabytes (the backend accepts videos up to 50 MB).
# MAX_BODY_MB=52
# Seconds to wait for the backend to start answering.
# UPSTREAM_TIMEOUT=30
# Open sockets allowed per client IP.
# MAX_SOCKETS_PER_IP=5
# Set to true ONLY when exactly one trusted reverse proxy sits in front of the
# gateway and sets X-Forwarded-For. Otherwise the header is ignored.
# TRUST_PROXY=false
# Comma-separated Origins allowed to open the socket. Native apps send no Origin.
# Empty refuses every browser page. No wildcard.
# WS_ORIGINS=
