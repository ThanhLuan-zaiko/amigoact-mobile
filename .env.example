# Copy this file to .env. The app reads it when Metro starts.

# Address of the gateway (see gateway/README.md). A URL only, never a secret:
# every EXPO_PUBLIC_* value is readable inside the app.
# Android emulator: http://10.0.2.2:8200. Physical phone: http://<LAN IP of this PC>:8200.
EXPO_PUBLIC_API_URL=

# Optional, at build time only. The web host that sends the emails, with no scheme or
# path, to open reset links in the app. See docs/deep-links.md.
# APP_LINK_HOST=

# Optional. The public address of the web app (amigoact-fe APP_URL), a URL only.
# The attendance QR opens <EXPO_PUBLIC_APP_URL>/checkin?token=..., so any phone camera
# can open it. Without it the QR uses the app scheme (amigoact://checkin?token=...).
# EXPO_PUBLIC_APP_URL=
